  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev --webpack",
    "dev:https": "next dev --webpack --experimental-https",
    "lint": "eslint . --max-warnings=0",
    "typegen": "next typegen --webpack",
    "typecheck": "npm run typegen && tsc --noEmit --pretty false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run invitation:validate && npm run lint && npm run typecheck && npm run test && npm run build",
    "invitation:new": "node --import tsx scripts/invitation-new.ts",
    "invitation:validate": "node --import tsx scripts/invitation-validate.ts",
    "worker:whatsapp": "node --import tsx workers/whatsapp/index.ts",
    "start": "next start"
  },
