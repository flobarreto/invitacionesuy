# Server-only Supabase access. Never expose the service-role key to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Canonical browser origin used by the CSRF Origin check. Additional trusted
# origins can be supplied as a comma-separated list.
APP_URL=http://localhost:3000
ADMIN_ALLOWED_ORIGINS=

# Generate every configured application secret independently, for example with
# `openssl rand -base64 48`. Values shorter than 32 UTF-8 bytes are rejected.

# Opaque administrator sessions (1 hour to 30 days; default is 7 days).
ADMIN_SESSION_TTL_SECONDS=604800
ADMIN_SESSION_FINGERPRINT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-bytes

# HMAC key used for database-backed API rate-limit identifiers.
RATE_LIMIT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-bytes

# Explicit development-only adapter. Production fails closed if Supabase is unavailable.
ENABLE_CSV_RSVP_ADAPTER=false
# Used only by local visual tests that intentionally run without Supabase.
ENABLE_STATIC_INVITATION_EVENT_ADAPTER=false

# Stable encryption key used for invitation tokens and WhatsApp auth state.
# Rotating it requires migrating every ciphertext encrypted with the prior key.
INVITIA_ENCRYPTION_KEY=replace-with-a-stable-random-secret-of-at-least-32-bytes

# Persistent WhatsApp worker (Railway). Keep the allowlist populated in staging.
PUBLIC_APP_URL=http://localhost:3000
PHONE_HASH_SECRET=replace-with-an-independent-random-secret-of-at-least-32-bytes
WHATSAPP_GLOBAL_ENABLED=false
WHATSAPP_ALLOWLIST=+59899123456
# Solo después de aprobar staging y el piloto; no combinar con la allowlist.
WHATSAPP_ALLOW_ALL=false
WHATSAPP_MIN_DELAY_MS=8000
WHATSAPP_MAX_DELAY_MS=15000
WHATSAPP_HOURLY_LIMIT=200
